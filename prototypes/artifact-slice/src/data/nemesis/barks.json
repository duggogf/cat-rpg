[
  {"Name": "_comment", "_src": "PROTOTYPE - NOT FOR PRODUCTION. Bark templates (Nemesis §3.15 grammar; selection F8). Narrative owns every word: these are the GDD's placeholder lines plus 'any' floors so every trigger the slice fires has a candidate. Own-history rule (G8): memory tags are always the speaker's own; {other} binds only to the speaker's own relations[] or OLD_GANG entry; mikan_plastered needs the speaker's own WON. <= 60 characters at maximum slot length (address 8, mikan 8, other 8, patch 16, title 16, when 14). Lint: tests/unit/nemesis/barks.test.mjs."},

  {"Name": "sf_braggart_pet", "trigger": "STANDOFF_FIRST", "requires": ["clout:house_pet"], "forbids": [], "personality": "braggart", "intent": "Taunt", "text": "Nice bell, {address}. Does it ring when you run?", "short_text": "Nice bell. Does it ring when you run?", "_src": "Nemesis §3.15 example; plan §2.2 4:45"},
  {"Name": "sf_braggart", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "braggart", "intent": "Taunt", "text": "Off my wall, {address}. Loudest cat wins.", "short_text": "Off my wall. Loudest cat wins.", "_src": "Placeholder floor (Narrative words it)"},
  {"Name": "sf_brooder", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "brooder", "intent": "Threat", "text": "...A bell. On my lane.", "short_text": "...A bell.", "_src": "Placeholder floor: Brooder 'silent stare' (§3.4)"},
  {"Name": "sf_schemer", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "schemer", "intent": "Taunt", "text": "Lost, {address}? I know the way out.", "short_text": "Lost? I know the way out.", "_src": "Placeholder floor"},
  {"Name": "sf_fraidy", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "fraidy", "intent": "Panic", "text": "Stay back! I'll hiss! I really will!", "short_text": "Stay back!", "_src": "Placeholder floor"},
  {"Name": "sf_stalwart", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "stalwart", "intent": "Threat", "text": "Turn around, {address}. No shame in it.", "short_text": "Turn around. No shame in it.", "_src": "Placeholder floor"},
  {"Name": "sf_goofball", "trigger": "STANDOFF_FIRST", "requires": [], "forbids": [], "personality": "goofball", "intent": "Tease", "text": "Ooh, a bell! Can I have it?", "short_text": "Ooh, a bell!", "_src": "Placeholder floor (Goofball defaults to Tease)"},

  {"Name": "rf_braggart_own", "trigger": "REMATCH_I_FLED", "requires": ["fled", "own_patch"], "forbids": [], "personality": "braggart", "intent": "Taunt", "text": "I ran yesterday. Not off my own post, {address}.", "short_text": "I ran yesterday. Not off my own post.", "_src": "Nemesis §3.8.1 / §3.15 REMATCH_I_FLED, the day-2 memory line (plan §2.2 7:05)"},
  {"Name": "rf_any", "trigger": "REMATCH_I_FLED", "requires": ["fled"], "forbids": [], "personality": "any", "intent": "Threat", "text": "Ran once. Won't run twice.", "short_text": "Won't run twice.", "_src": "Placeholder (memory-tagged)"},
  {"Name": "rf_floor", "trigger": "REMATCH_I_FLED", "requires": [], "forbids": [], "personality": "any", "intent": "Grumble", "text": "You again.", "short_text": "You again.", "_src": "Placeholder floor"},

  {"Name": "rl_braggart_water", "trigger": "REMATCH_I_LOST", "requires": ["fear_exploited:water", "scar_from_mikan:cowlick"], "forbids": [], "personality": "braggart", "intent": "Threat", "text": "I still smell like that bucket. Soon, so will you.", "short_text": "I still smell like that bucket.", "_src": "Nemesis §3.15 example"},
  {"Name": "rl_notch", "trigger": "REMATCH_I_LOST", "requires": ["scar_from_mikan:notch"], "forbids": [], "personality": "any", "intent": "Threat", "text": "You gave me this notch. I kept it.", "short_text": "You gave me this notch.", "_src": "Placeholder (memory-tagged)"},
  {"Name": "rl_floor", "trigger": "REMATCH_I_LOST", "requires": [], "forbids": [], "personality": "any", "intent": "Grumble", "text": "Back for more, {address}?", "short_text": "Back for more?", "_src": "Placeholder floor"},

  {"Name": "rw_lick", "trigger": "REMATCH_I_WON", "requires": ["lick_in"], "forbids": [], "personality": "any", "intent": "Boast", "text": "Flat on your back, {address}. Your crew carried you.", "short_text": "Flat on your back. Your crew carried you.", "_src": "Nemesis §3.15 example (Lick In)"},
  {"Name": "rw_plaster", "trigger": "REMATCH_I_WON", "requires": ["mikan_plastered"], "forbids": [], "personality": "any", "intent": "Boast", "text": "Nice plaster, {address}. Fall off a cushion?", "short_text": "Nice plaster. Fall off a cushion?", "_src": "Nemesis §3.8.6 / §3.15: only the victor may read the plaster"},
  {"Name": "rw_floor", "trigger": "REMATCH_I_WON", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "Remember how that ended?", "short_text": "Remember?", "_src": "Placeholder floor"},

  {"Name": "rt_water", "trigger": "RETURNED", "requires": ["adapted:got_over_it_water"], "forbids": [], "personality": "any", "intent": "Taunt", "text": "Go on, tip the bucket. I like the rain now.", "short_text": "Go on, tip the bucket.", "_src": "Nemesis §3.9 / §3.15 example"},
  {"Name": "rt_floor", "trigger": "RETURNED", "requires": [], "forbids": [], "personality": "any", "intent": "Taunt", "text": "Missed me, {address}?", "short_text": "Missed me?", "_src": "Placeholder floor"},

  {"Name": "tg_braggart", "trigger": "TRUCE_GREET", "requires": ["truce"], "forbids": [], "personality": "braggart", "intent": "Yield", "text": "Don't get used to the nose thing, {address}.", "short_text": "Don't get used to the nose thing.", "_src": "Nemesis §3.15 example"},
  {"Name": "tg_friend", "trigger": "TRUCE_GREET", "requires": ["friend"], "forbids": [], "personality": "any", "intent": "Respect", "text": "{mikan}. Good to see you.", "short_text": "Good to see you.", "_src": "Placeholder (relationship-tagged)"},
  {"Name": "tg_floor", "trigger": "TRUCE_GREET", "requires": [], "forbids": [], "personality": "any", "intent": "Yield", "text": "Noses only today, {address}.", "short_text": "Noses only today.", "_src": "Placeholder floor"},

  {"Name": "vc_braggart", "trigger": "VERDICT_CHASE", "requires": [], "forbids": [], "personality": "braggart", "intent": "Grumble", "text": "Fine! I've got other walls. Better walls!", "short_text": "Fine! I've got other walls.", "_src": "Nemesis §3.7 / §3.15: Togemaru's farewell (F11 ending)"},
  {"Name": "vc_floor", "trigger": "VERDICT_CHASE", "requires": [], "forbids": [], "personality": "any", "intent": "Grumble", "text": "I'm going. I'm going.", "short_text": "I'm going.", "_src": "Placeholder floor"},
  {"Name": "vr_braggart_water", "trigger": "VERDICT_RECRUIT", "requires": ["fear_exploited:water"], "forbids": [], "personality": "braggart", "intent": "Yield", "text": "Fine. But you're never touching that bucket again.", "short_text": "Fine. Never the bucket again.", "_src": "Nemesis §3.15 example"},
  {"Name": "vr_braggart", "trigger": "VERDICT_RECRUIT", "requires": [], "forbids": [], "personality": "braggart", "intent": "Boast", "text": "Fine. Loudest cat on your crew, then.", "short_text": "Fine. Loudest cat on your crew.", "_src": "Placeholder"},
  {"Name": "vr_floor", "trigger": "VERDICT_RECRUIT", "requires": [], "forbids": [], "personality": "any", "intent": "Yield", "text": "...Alright. The bell it is.", "short_text": "The bell it is.", "_src": "Placeholder floor"},
  {"Name": "vn_braggart_own", "trigger": "VERDICT_NOSE", "requires": ["own_patch"], "forbids": [], "personality": "braggart", "intent": "Yield", "text": "Keep the post. I'll be back for it. Ten days.", "short_text": "Keep the post. Ten days.", "_src": "Nemesis §3.15 / §3.16 A"},
  {"Name": "vn_stalwart", "trigger": "VERDICT_NOSE", "requires": [], "forbids": [], "personality": "stalwart", "intent": "Respect", "text": "...Fair. You fought fair.", "short_text": "...Fair.", "_src": "Nemesis §3.15 example"},
  {"Name": "vn_floor", "trigger": "VERDICT_NOSE", "requires": [], "forbids": [], "personality": "any", "intent": "Yield", "text": "Noses, then. For now.", "short_text": "Noses, then.", "_src": "Placeholder floor"},

  {"Name": "gl_swat", "trigger": "GLOAT_SWAT", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "Ding ding, {address}!", "short_text": "Ding ding!", "_src": "Placeholder (Swat the Bell)"},
  {"Name": "gl_loaf", "trigger": "GLOAT_LOAF", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "...Comfy.", "short_text": "...Comfy.", "_src": "Placeholder (Loaf On)"},
  {"Name": "gl_circle", "trigger": "GLOAT_CIRCLE", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "Round and round you go, {address}.", "short_text": "Round you go.", "_src": "Placeholder (Sly Circle)"},
  {"Name": "gl_turn_away", "trigger": "GLOAT_TURN_AWAY", "requires": [], "forbids": [], "personality": "stalwart", "intent": "Boast", "text": "Good scrap. Come back when the bell means something.", "short_text": "Good scrap. Come back later.", "_src": "Nemesis §3.15 example"},
  {"Name": "gl_turn_away_any", "trigger": "GLOAT_TURN_AWAY", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "Good scrap.", "short_text": "Good scrap.", "_src": "Placeholder floor"},
  {"Name": "gl_bolt", "trigger": "GLOAT_BOLT", "requires": [], "forbids": [], "personality": "any", "intent": "Boast", "text": "Did I win? I won!", "short_text": "I won!", "_src": "Placeholder (Bolt)"},

  {"Name": "aj_rival", "trigger": "ALLY_JOIN", "requires": ["rival_of"], "forbids": [], "personality": "any", "intent": "Respect", "text": "{other}! I've waited for this one.", "short_text": "I've waited for this one.", "_src": "Nemesis §3.15 example ({other} = the joiner's own Rival)"},
  {"Name": "aj_floor", "trigger": "ALLY_JOIN", "requires": [], "forbids": [], "personality": "any", "intent": "Respect", "text": "Move over, {address}.", "short_text": "Move over.", "_src": "Placeholder floor"},
  {"Name": "og_flinch", "trigger": "OLD_GANG_FLINCH", "requires": ["old_boss"], "forbids": [], "personality": "any", "intent": "Panic", "text": "...That's {other}'s wall.", "short_text": "...That's his wall.", "_src": "Nemesis §3.15 / §3.18 (the recruit's own line)"},
  {"Name": "og_defiant", "trigger": "OLD_GANG_DEFIANT", "requires": ["old_boss"], "forbids": [], "personality": "any", "intent": "Threat", "text": "Not your cat anymore.", "short_text": "Not your cat anymore.", "_src": "Nemesis §3.15 / §3.18; plan branch D (Hige's line; B: Togemaru's too)"},
  {"Name": "st_steeled", "trigger": "STEELED", "requires": ["old_gang"], "forbids": [], "personality": "any", "intent": "Respect", "text": "Right. Right. I'm with the bell.", "short_text": "I'm with the bell.", "_src": "Nemesis §3.15 example"},
  {"Name": "ks_kin", "trigger": "KIN_SPARE", "requires": ["kin_of"], "forbids": [], "personality": "any", "intent": "Panic", "text": "Not {other}. Anyone but {other}.", "short_text": "Not my kin.", "_src": "Placeholder (KIN_SPARE, spoken by the Crew cat)"},
  {"Name": "cs_stake", "trigger": "CHALLENGE_STAKE", "requires": [], "forbids": [], "personality": "any", "intent": "Threat", "text": "This post's mine now, {address}.", "short_text": "This post's mine now.", "_src": "Nemesis §3.20 / plan §2.2 11:15"},
  {"Name": "bp_furious", "trigger": "BOSS_POSTS", "requires": ["anger:furious"], "forbids": [], "personality": "any", "intent": "Threat", "text": "Every post. Every one. Stinking of bell.", "short_text": "Every post stinks of bell.", "_src": "Placeholder (anger by stage, his own posts)"},
  {"Name": "bp_seething", "trigger": "BOSS_POSTS", "requires": ["anger:seething"], "forbids": [], "personality": "brooder", "intent": "Threat", "text": "My posts reek of you. Every one.", "short_text": "My posts reek of you.", "_src": "Nemesis §3.15 example"},
  {"Name": "bp_riled", "trigger": "BOSS_POSTS", "requires": ["anger:riled"], "forbids": [], "personality": "any", "intent": "Grumble", "text": "Someone's been at my posts.", "short_text": "Someone's been at my posts.", "_src": "Placeholder"},
  {"Name": "bp_floor", "trigger": "BOSS_POSTS", "requires": [], "forbids": [], "personality": "any", "intent": "Threat", "text": "Come back when the Lane smells of you, {address}.", "short_text": "Come back later.", "_src": "Nemesis §3.19 patrol 1 (before the window)"},
  {"Name": "ar_ambushed", "trigger": "AMBUSHED_REMATCH", "requires": ["ambushed"], "forbids": [], "personality": "any", "intent": "Grumble", "text": "The roof again? You never fight on the ground, {address}.", "short_text": "The roof again?", "_src": "Nemesis §3.15 example"},
  {"Name": "ar_floor", "trigger": "AMBUSHED_REMATCH", "requires": [], "forbids": [], "personality": "any", "intent": "Grumble", "text": "From above? Cheap.", "short_text": "Cheap.", "_src": "Placeholder floor"}
